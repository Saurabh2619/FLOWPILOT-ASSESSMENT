# Copy to server/.env and adjust. Never commit server/.env.
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app, used in password reset links
APP_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot
# Required, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
RESET_TOKEN_TTL_MINUTES=30
# Requests allowed per IP per 15 minutes on sensitive auth routes
AUTH_RATE_LIMIT=20
# Number of reverse proxies in front of the API (affects client IP detection)
TRUST_PROXY=0
# Signs mock billing webhooks. Leave empty to generate one at startup.
BILLING_WEBHOOK_SECRET=
# Website additions allowed per IP per 15 minutes
WEBSITE_RATE_LIMIT=30
# Set to false to run the API without the background audit worker
RUN_WORKER=true
